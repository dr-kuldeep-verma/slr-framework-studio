# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv/
venv/
/env/

# Testing
.pytest_cache/
.coverage
coverage.xml
/htmlcov/

# PyInstaller working files
packaging/build/
packaging/dist/
*.manifest

# Vendored binaries: Tesseract and fonts are downloaded at build time rather
# than committed. They are large, and redistributing them has licence terms
# of its own that this repository does not take on.
packaging/vendor/

# Review projects. A .slr file holds a reviewer's corpus, their decisions and
# in some cases full texts they are licensed to read but not to redistribute.
# Nothing of the sort belongs in a public repository, and this line is the
# reason it will not arrive there by accident.
*.slr
*.slr-wal
*.slr-shm

# Output folders a reviewer creates while working, at the top level only.
#
# The leading slash matters and its absence was a real bug: written as
# `exports/`, this pattern matches a directory of that name at ANY depth,
# and it silently swallowed src/slr_studio/exports/ -- ten modules that
# write every Word, PDF, Excel and REFI-QDA output the application
# produces. They were never committed, so the repository on GitHub was
# missing a whole package and any build made from it died on startup with
# "No module named 'slr_studio.exports'". A test now asserts that nothing
# under src/ is ignored.
/demo-review/
/exports/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Download cache written by the synergy-dataset tool
/synergy_cache.sqlite
